# Build and disposable test output.
/target/
/dist/
/tmp/
*.pyc
__pycache__/
.DS_Store

# Local KMP machine state. The reviewable `.kmp/memory.jsonl` recovery
# bundle is deliberately not ignored.
/.kernel/
/.rehydration/

# Generated test evidence stays outside the tracked repository history.
/artifacts/

# Per-developer agent configuration.
/.codex/

# Per-developer agent settings and the temp files the harness writes beside
# them. These carry local paths and internal hostnames; this repo is public.
/.claude/settings.local.json
/.claude/settings.local.json.tmp.*

# Local credentials and overrides must never enter the public repository.
.env
.env.*
!.env.example
