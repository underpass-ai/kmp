            "document": "README.md, section 'Talk to it like a human'"
          }
        },
        {
          "id": "project:kmp:decision:local-first-embedded",
          "kind": "decision",
          "text": "The default path is one local binary with an embedded SQLite store, a local stdio MCP transport and a loopback viewer. The shared Kubernetes topology is optional and self-operated.",
          "coordinates": [
            {
              "dimension": "timeline",
              "scope_id": "timeline",
              "occurred_at": "2026-08-13T12:00:00Z",
              "observed_at": "2026-08-13T12:00:00Z",
