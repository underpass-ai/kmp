              "scope_id": "documentation",
              "sequence": 3
            }
          ],
          "metadata": {
            "source": "repository",
            "document": "AGENTS.md, section 'Public README parity'"
          }
        },
        {
          "id": "project:kmp:constraint:guides-generated-from-editorial",
          "kind": "constraint",
          "text": "Both installed guides derive from plugins/kmp/guide/editorial.json. AGENT.md, guide.requests.json and guide/memory.jsonl are generated with the matching binary and never edited separately.",
          "coordinates": [
            {
              "dimension": "timeline",
              "scope_id": "timeline",
              "occurred_at": "2026-08-28T12:00:00Z",
              "observed_at": "2026-08-28T12:00:00Z",
              "sequence": 4
