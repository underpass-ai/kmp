          "metadata": {
            "source": "repository",
            "document": "CHANGELOG.md, 0.25.0, Changed (#850)"
          }
        },
        {
          "id": "project:kmp:decision:saved-selection-beat-project-discovery",
          "kind": "decision",
          "text": "A saved memory_store selection applied to the whole machine and beat project discovery, so one saved value decided the store for every repository.",
          "coordinates": [
            {
              "dimension": "timeline",
              "scope_id": "timeline",
              "occurred_at": "2026-09-05T12:00:00Z",
              "observed_at": "2026-09-05T12:00:00Z",
              "sequence": 11
