        {
          "id": "project:kmp:decision:decisions-not-transcripts",
          "kind": "decision",
          "text": "KMP stores decisions, constraints, outcomes and the evidence behind them. It never stores transcripts.",
          "coordinates": [
            {
              "dimension": "timeline",
              "scope_id": "timeline",
              "occurred_at": "2026-08-13T12:00:00Z",
              "observed_at": "2026-08-13T12:00:00Z",
