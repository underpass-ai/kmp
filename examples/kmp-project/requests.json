            "source": "repository",
            "document": "CHANGELOG.md, 0.25.0, Changed (#903)"
          }
        },
        {
          "id": "project:kmp:observation:crates-publish-index-race",
          "kind": "observation",
          "text": "The v0.25.0 crate publication failed: `cargo publish -p kmp-mcp` could not resolve kmp-domain 0.25.0 from the crates.io index two minutes after that crate was published, so crates.io stayed at 0.24.0 and the MCP Registry publication waited for a package that never came.",
          "coordinates": [
            {
              "dimension": "timeline",
              "scope_id": "timeline",
              "occurred_at": "2026-10-04T18:30:00Z",
              "observed_at": "2026-10-04T18:30:00Z",
              "sequence": 14
            },
            {
              "dimension": "area",
              "scope_id": "release",
              "sequence": 14
            }
          ],
          "metadata": {
            "source": "repository",
            "document": "GitHub Actions run 37224430411, job publish-crates"
          }
        },
        {
          "id": "project:kmp:decision:wait-for-index-before-dependents",
          "kind": "decision",
          "text": "The crate publish chain waits until each published version is visible in the crates.io index before publishing its dependents, the publication can be resumed by an explicit dispatch, and a storefront check reports where GitHub, crates.io, the MCP Registry and the marketplace branch disagree.",
          "coordinates": [
            {
              "dimension": "timeline",
              "scope_id": "timeline",
              "occurred_at": "2026-10-06T12:00:00Z",
              "observed_at": "2026-10-06T12:00:00Z",
              "sequence": 15
            },
            {
              "dimension": "area",
              "scope_id": "release",
              "sequence": 15
            }
          ],
          "metadata": {
            "source": "repository",
            "document": "CHANGELOG.md, Unreleased"
          }
        },
        {
          "id": "project:kmp:decision:guide-seeded-on-first-read",
          "kind": "decision",
          "text": "A guide read on a store that has no guide seeds it from the installed assets that match the binary — the launcher's KMP_PLUGIN_ROOT, the bundled engine's plugin or the host plugin cache for this version — and reads again. The explicit sync remains for shared kernels and repair.",
          "coordinates": [
            {
              "dimension": "timeline",
              "scope_id": "timeline",
              "occurred_at": "2026-10-06T12:00:00Z",
              "observed_at": "2026-10-06T12:00:00Z",
              "sequence": 16
            },
            {
              "dimension": "area",
              "scope_id": "agent-surface",
              "sequence": 16
            }
          ],
          "metadata": {
            "source": "repository",
            "document": "CHANGELOG.md, Unreleased"
          }
        },
