          ],
          "metadata": {
            "source": "repository",
            "document": "CHANGELOG.md, 0.25.0, Changed (#903), describing the behavior before 0.25.0"
          }
        },
        {
          "id": "project:kmp:observation:saved-selection-captured-every-repository",
          "kind": "observation",
          "text": "A saved selection sent every repository on the machine to the one store it named, so project memory landed in a store nobody chose for that project.",
          "coordinates": [
            {
              "dimension": "timeline",
              "scope_id": "timeline",
              "occurred_at": "2026-10-03T12:00:00Z",
              "observed_at": "2026-10-03T12:00:00Z",
