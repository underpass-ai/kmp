          }
        },
        {
          "id": "project:kmp:decision:store-selection-order",
          "kind": "decision",
          "text": "Store selection runs KMP_MCP_DATA_DIR, then the nearest project, then the saved selection, then the per-user default. A saved selection applies only where no project is found, and a git worktree opens its main checkout's store.",
          "coordinates": [
            {
              "dimension": "timeline",
              "scope_id": "timeline",
              "occurred_at": "2026-10-04T12:00:00Z",
              "observed_at": "2026-10-04T12:00:00Z",
              "sequence": 13
