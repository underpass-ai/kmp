              "sequence": 2
            }
          ],
          "metadata": {
            "source": "repository",
            "document": "README.md, section 'Local means local'"
          }
        },
        {
          "id": "project:kmp:constraint:public-overview-canonical",
          "kind": "constraint",
          "text": "The marked public-overview block in plugins/kmp/README.md is canonical. The GitHub and crates.io READMEs are synchronized from it with `kmp-release readme sync`, never edited by hand.",
          "coordinates": [
            {
              "dimension": "timeline",
              "scope_id": "timeline",
              "occurred_at": "2026-08-26T12:00:00Z",
              "observed_at": "2026-08-26T12:00:00Z",
              "sequence": 3
