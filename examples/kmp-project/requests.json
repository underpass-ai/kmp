              "sequence": 9
            }
          ],
          "metadata": {
            "source": "repository",
            "document": "GitHub issue #850"
          }
        },
        {
          "id": "project:kmp:decision:parameter-prose-served-by-guide",
          "kind": "decision",
          "text": "tools/list carries no parameter descriptions. Each tool keeps a one-line description naming its kmp_guide topic, and that topic's card returns the parameter descriptions as card.parameters. A session starts with 12,649 reference tokens instead of 24,426.",
          "coordinates": [
            {
              "dimension": "timeline",
              "scope_id": "timeline",
              "occurred_at": "2026-09-28T12:00:00Z",
              "observed_at": "2026-09-28T12:00:00Z",
              "sequence": 10
