            "document": "AGENTS.md, section 'Guide parity'"
          }
        },
        {
          "id": "project:kmp:constraint:every-advertised-version-installable",
          "kind": "constraint",
          "text": "Every advertised version must be installable: the public marketplace branch must never point at a tag, or at engine assets, that are not public yet.",
          "coordinates": [
            {
              "dimension": "timeline",
              "scope_id": "timeline",
              "occurred_at": "2026-08-30T12:00:00Z",
              "observed_at": "2026-08-30T12:00:00Z",
              "sequence": 5
            },
            {
              "dimension": "area",
              "scope_id": "release",
              "sequence": 5
            }
          ],
          "metadata": {
            "source": "repository",
            "document": "docs/development/releasing.md, section 'Before tagging'"
          }
        },
        {
          "id": "project:kmp:decision:catalog-after-assets",
          "kind": "decision",
          "text": "A release tags the reviewed candidate, waits until the GitHub release and all twenty-two checksummed assets are public, and only then advances the protected marketplace branch to that commit.",
          "coordinates": [
            {
              "dimension": "timeline",
              "scope_id": "timeline",
              "occurred_at": "2026-08-30T12:00:00Z",
              "observed_at": "2026-08-30T12:00:00Z",
              "sequence": 6
            },
            {
              "dimension": "area",
              "scope_id": "release",
              "sequence": 6
            }
          ],
          "metadata": {
            "source": "repository",
            "document": "crates/kmp-release/src/application/use_cases/run_release_publication.rs (#446)"
          }
        },
        {
          "id": "project:kmp:constraint:setup-never-writes-memory",
          "kind": "constraint",
          "text": "Setup and update install the plugin tree and the checksummed engine. They never select a memory store and never write memory.",
          "coordinates": [
            {
              "dimension": "timeline",
              "scope_id": "timeline",
              "occurred_at": "2026-08-28T12:00:00Z",
              "observed_at": "2026-08-28T12:00:00Z",
              "sequence": 7
            },
            {
              "dimension": "area",
              "scope_id": "agent-surface",
              "sequence": 7
            }
          ],
          "metadata": {
            "source": "repository",
            "document": "plugins/kmp/skills/kmp-setup/SKILL.md"
          }
        },
        {
          "id": "project:kmp:decision:guide-through-explicit-sync",
          "kind": "decision",
          "text": "A fresh store receives the installed guides only through the explicit kmp-guide workflow (`/kmp:guide` in Claude Code); until then a guide read returns GUIDE_UNAVAILABLE with the command to type.",
          "coordinates": [
            {
              "dimension": "timeline",
              "scope_id": "timeline",
              "occurred_at": "2026-08-28T12:00:00Z",
              "observed_at": "2026-08-28T12:00:00Z",
              "sequence": 8
            },
            {
              "dimension": "area",
              "scope_id": "agent-surface",
              "sequence": 8
            }
          ],
          "metadata": {
            "source": "repository",
            "document": "plugins/kmp/README.md v0.25.0, section 'Initialize the selected store'"
          }
        },
        {
          "id": "project:kmp:observation:tools-list-dominated-journeys",
          "kind": "observation",
          "text": "Measured on v0.20.0, tools/list was 80 to 97 percent of the reference tokens of every agent journey.",
          "coordinates": [
            {
              "dimension": "timeline",
              "scope_id": "timeline",
              "occurred_at": "2026-09-24T12:00:00Z",
              "observed_at": "2026-09-24T12:00:00Z",
