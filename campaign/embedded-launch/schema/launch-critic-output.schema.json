{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://underpass.ai/schemas/kmp-launch-critic-output.json",
  "title": "KMP launch critic output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "campaign_id", "decision", "evaluated_at", "auditor",
    "input_manifest_sha256", "critical_blockers", "scores", "masters", "roles",
    "commands_run", "tool_versions", "human_panels", "required_remediations",
    "residual_risks"
  ],
  "properties": {
    "schema_version": {"const": "1"},
    "campaign_id": {"type": "string", "minLength": 1},
    "decision": {"enum": ["GO", "NO_GO", "INCOMPLETE"]},
    "evaluated_at": {"type": "string", "format": "date-time"},
    "auditor": {
      "type": "object", "additionalProperties": false,
      "required": ["role", "independent_from_authors"],
      "properties": {
        "role": {"const": "kmp-launch-critic"},
        "independent_from_authors": {"const": true}
      }
    },
    "input_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "critical_blockers": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "scope", "finding", "evidence", "required_resolution"],
        "properties": {
          "id": {"type": "string", "pattern": "^B[0-9]{2,}$"},
          "scope": {"type": "string", "minLength": 1},
          "finding": {"type": "string", "minLength": 1},
          "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "required_resolution": {"type": "string", "minLength": 1}
        }
      }
    },
    "scores": {
      "type": "object", "additionalProperties": false,
      "required": ["campaign_total", "domains"],
      "properties": {
        "campaign_total": {"type": "number", "minimum": 0, "maximum": 100},
        "domains": {
          "type": "object", "additionalProperties": false,
          "required": ["claim_integrity", "capture_authenticity", "visual_mobile", "audio", "accessibility_distribution", "reproducibility_provenance", "governance"],
          "properties": {
            "claim_integrity": {"type": "number", "minimum": 0, "maximum": 10},
            "capture_authenticity": {"type": "number", "minimum": 0, "maximum": 10},
            "visual_mobile": {"type": "number", "minimum": 0, "maximum": 10},
            "audio": {"type": "number", "minimum": 0, "maximum": 10},
            "accessibility_distribution": {"type": "number", "minimum": 0, "maximum": 10},
            "reproducibility_provenance": {"type": "number", "minimum": 0, "maximum": 10},
            "governance": {"type": "number", "minimum": 0, "maximum": 10}
          }
        }
      }
    },
    "masters": {"type": "array", "items": {"type": "object"}},
    "roles": {"type": "object"},
    "commands_run": {"type": "array", "items": {"type": "string"}},
    "tool_versions": {"type": "object"},
    "human_panels": {"type": "object"},
    "required_remediations": {"type": "array", "items": {"type": "string"}},
    "residual_risks": {"type": "array", "items": {"type": "string"}}
  }
}
