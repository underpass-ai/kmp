{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://underpass.ai/schemas/kmp-launch-critic-input.json",
  "title": "KMP launch critic input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "campaign_id", "release", "product", "brief_path",
    "source_root", "evidence_pack_root", "masters", "role_contracts",
    "distribution_profiles", "required_human_panels"
  ],
  "properties": {
    "schema_version": {"const": "1"},
    "campaign_id": {"type": "string", "minLength": 1},
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "tag", "public_url", "quality_gate_url"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "tag": {"type": "string", "minLength": 1},
        "public_url": {"type": "string", "minLength": 1},
        "quality_gate_url": {"type": "string", "minLength": 1}
      }
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binary_path", "binary_sha256", "version", "tool_list_path"],
      "properties": {
        "binary_path": {"type": "string", "minLength": 1},
        "binary_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "version": {"type": "string", "minLength": 1},
        "tool_list_path": {"type": "string", "minLength": 1}
      }
    },
    "brief_path": {"type": "string", "minLength": 1},
    "source_root": {"type": "string", "minLength": 1},
    "evidence_pack_root": {"type": "string", "minLength": 1},
    "masters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "sha256", "claim_ids", "platforms"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "claim_ids": {"type": "array", "items": {"type": "string"}},
          "platforms": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        }
      }
    },
    "role_contracts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["marketing", "audio"],
      "properties": {
        "marketing": {"type": "string", "minLength": 1},
        "audio": {"type": "string", "minLength": 1}
      }
    },
    "distribution_profiles": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "required_human_panels": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mobile_muted", "audio_trained"],
      "properties": {
        "mobile_muted": {"type": "integer", "minimum": 5},
        "audio_trained": {"type": "integer", "minimum": 1}
      }
    }
  }
}
