{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://underpass.ai/schemas/kmp-campaign-brief.json",
  "title": "KMP campaign brief",
  "type": "object",
  "additionalProperties": false,
  "required": ["campaign_id", "product_commit", "binary", "masters", "constraints"],
  "properties": {
    "campaign_id": {"type": "string", "minLength": 1},
    "concept": {"type": "string", "minLength": 1},
    "product_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "binary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "version"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "masters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "duration_seconds", "beats"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "duration_seconds": {"type": "number", "exclusiveMinimum": 0},
          "picture_source": {"type": "string"},
          "captions": {"type": "string"},
          "beats": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["start", "end", "visual_action", "product_action", "copy"],
              "properties": {
                "start": {"type": "number", "minimum": 0},
                "end": {"type": "number", "exclusiveMinimum": 0},
                "visual_action": {"type": "string"},
                "product_action": {"type": ["string", "null"]},
                "copy": {"type": "string"}
              }
            }
          }
        }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["muted_complete", "third_party_audio", "autoplay_muted"],
      "properties": {
        "muted_complete": {"const": true},
        "third_party_audio": {"const": false},
        "autoplay_muted": {"const": true},
        "real_hosts_required_for_host_names": {"type": "boolean"}
      }
    }
  }
}
