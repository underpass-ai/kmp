{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://underpass.ai/kmp/campaign/obs-capture-scenario.schema.json",
  "title": "KMP real OBS capture scenario",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "about", "duration_ms", "bootstrap", "steps"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": { "type": "string", "minLength": 1 },
    "about": { "type": "string", "minLength": 1 },
    "fixture_label": { "type": "string" },
    "stores": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
        }
      }
    },
    "processes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "store_id"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "store_id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "autostart": { "type": "boolean", "default": true },
          "browser": { "type": "boolean", "default": false }
        }
      }
    },
    "duration_ms": { "type": "integer", "minimum": 3000, "maximum": 180000 },
    "bootstrap": {
      "type": "array",
      "items": { "$ref": "#/$defs/tool" }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/say" },
          { "$ref": "#/$defs/tool" },
          { "$ref": "#/$defs/process" },
          { "$ref": "#/$defs/hold" }
        ]
      }
    }
  },
  "$defs": {
    "base": {
      "type": "object",
      "required": ["at_ms", "type"],
      "properties": {
        "at_ms": { "type": "integer", "minimum": 0 }
      }
    },
    "say": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["at_ms", "type", "speaker", "text"],
          "properties": {
            "at_ms": { "type": "integer", "minimum": 0 },
            "type": { "const": "say" },
            "speaker": { "enum": ["user", "process", "kmp"] },
            "text": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "hold": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["at_ms", "type"],
          "properties": {
            "at_ms": { "type": "integer", "minimum": 0 },
            "type": { "const": "hold" }
          }
        }
      ]
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["at_ms", "type", "name", "arguments"],
      "properties": {
        "at_ms": { "type": "integer", "minimum": 0 },
        "type": { "const": "tool" },
        "name": { "type": "string", "pattern": "^kmp_[a-z_]+$" },
        "process_id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "arguments": { "type": "object" },
        "display_paths": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "path"],
            "properties": {
              "label": { "type": "string" },
              "path": { "type": "string", "pattern": "^[A-Za-z0-9_.]+$" }
            }
          }
        }
      }
    },
    "process": {
      "type": "object",
      "additionalProperties": false,
      "required": ["at_ms", "type", "action", "process_id"],
      "properties": {
        "at_ms": { "type": "integer", "minimum": 0 },
        "type": { "const": "process" },
        "action": { "enum": ["start", "stop", "switch_browser"] },
        "process_id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
      }
    }
  }
}
